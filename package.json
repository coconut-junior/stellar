{
  "name": "stellar",
  "productName": "Stellar",
  "version": "2.2.3",
  "description": "Easily automate Adobe InDesign tasks",
  "homepage": "https://github.com/coconut-junior/stellar",
  "author": {
    "name": "Jimmy Blanck",
    "email": "blanckjm@gmail.com",
    "url": "https://jbx.design/"
  },
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "copyResources": "copyfiles -f * dist && copyfiles -f fonts/* dist/fonts && copyfiles images/* dist/images",
    "compile": "tsc && npm run copyResources",
    "start": "npm run compile && electron .",
    "lint": "echo \"No linting configured\"",
    "release": "npm run compile && electron-builder -mw --arm64 --x64"
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "coconut-junior",
      "repo": "stellar"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "appId": "design.jbx.stellar",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "notarize": false,
      "hardenedRuntime": true,
      "entitlements": "./entitlements.mac.plist",
      "entitlementsInherit": "./entitlements.mac.plist",
      "category": "public.app-category.productivity",
      "target": [
        "zip",
        "dmg"
      ]
    },
    "afterSign": "./notarize.js"
  },
  "repository": "https://github.com/coconut-junior/stellar",
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "@xhmikosr/decompress": "^11.1.3",
    "dialog-node": "^0.2.1",
    "dotenv": "^16.4.7",
    "electron-store": "^8.1.0",
    "electron-unhandled": "^5.0.0",
    "env-paths": "^3.0.0",
    "extract-zip": "^2.0.1",
    "gsap": "^3.12.5",
    "interactjs": "^1.10.27",
    "jquery": "^3.7.1",
    "node-fetch": "^2.7.0",
    "node-stream-zip": "^1.15.0",
    "party-js": "^2.2.0",
    "save": "^2.9.0",
    "universal-tilt.js": "^2.0.6",
    "update-electron-app": "^3.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.1",
    "@types/jquery": "^3.5.32",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "copyfiles": "^2.4.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.3.6",
    "node": "^24",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "node@24.18.0": true
  }
}
